# GENEALIS AI — exemple de configuration. Copiez ce fichier en « .env » (le script d'installation le fait pour vous).
# Ce fichier ne contient AUCUN secret : ne mettez jamais de clé API dans le code ni dans le frontend.
# Une ligne « NOM= » vide signifie « valeur par défaut ». Les commentaires sont sur des lignes séparées.
# « .env » est ignoré par git (.gitignore) : il reste sur votre PC.

# =============================== Worker navigateur (ce PC) — lu par scripts/start-worker.ps1 et .sh
# Adresse de l'application à laquelle relier le worker (ex. https://mon-genealis.vercel.app).
# Vide : application locale de ce PC (http://127.0.0.1:8765).
GENEALIS_SERVER_URL=
# Mot de passe d'accès de l'application (le même que ACCESS_TOKEN sur Vercel). Vide : demandé au lancement.
GENEALIS_ACCESS_TOKEN=
# Chemin de Chromium. Vide : celui installé par « python -m playwright install chromium ».
GENEALIS_CHROMIUM_PATH=
# 1 pour forcer le bac à sable de Chromium sous Linux (il est toujours actif sous Windows).
GENEALIS_CHROMIUM_SANDBOX=
# Clé Gemini du worker : préférez « scripts\start-worker.ps1 -SetGeminiKey » (stockée chiffrée sur ce PC)
# ou Paramètres → Intelligence artificielle de l'application locale. Ne la recopiez ici qu'en dernier recours.
GEMINI_API_KEY=

# =============================== Browser Use : télémétrie et synchronisation cloud désactivées
ANONYMIZED_TELEMETRY=false
BROWSER_USE_CLOUD_SYNC=false
BROWSER_USE_VERSION_CHECK=false

# =============================== Moteur (application locale ou hébergée)
# Dossier des données (base, documents, sauvegardes). Vide : %APPDATA%\GenealisAI sous Windows.
GENEALIS_DATA_DIR=
GENEALIS_HOST=127.0.0.1
GENEALIS_PORT=8765
GENEALIS_LOG_LEVEL=INFO
# Délai minimal (secondes) entre deux requêtes vers un même service d'archives.
GENEALIS_CONNECTOR_MIN_INTERVAL=2.0
GENEALIS_REQUEST_TIMEOUT=25

# =============================== Mode hébergé (Vercel) — à saisir dans Vercel → Settings → Environment Variables
# Mot de passe d'accès à l'interface et à l'API (obligatoire en ligne).
ACCESS_TOKEN=
# Phrase longue et aléatoire qui chiffre les clés API enregistrées dans les paramètres.
SECRET_KEY=
# Base PostgreSQL (Neon) : ajoutée automatiquement par l'intégration Vercel.
DATABASE_URL=
# Stockage des documents (Vercel Blob) : ajouté automatiquement par l'intégration Vercel.
BLOB_READ_WRITE_TOKEN=
# Protège la tâche planifiée quotidienne.
CRON_SECRET=

# =============================== Tests automatisés UNIQUEMENT — ne jamais activer en usage normal
# Autorise le navigateur à joindre 127.0.0.1 (serveur de test local). Laisser vide.
GENEALIS_BROWSER_TEST_ALLOW_LOCAL=
