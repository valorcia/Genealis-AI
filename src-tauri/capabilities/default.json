{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacités de la fenêtre principale",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*", "http://localhost:*"] },
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "opener:allow-open-url",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/genealis-backend", "sidecar": true, "args": true }]
    }
  ]
}
