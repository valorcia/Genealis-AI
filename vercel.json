{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "genealis.main:app",
      "functions": {
        "genealis/main.py": { "maxDuration": 300, "memory": 1024, "excludeFiles": "{genealis/tests/**,dist/**,build/**,**/__pycache__/**}" }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [ { "path": "/api/research/cron", "schedule": "17 5 * * *" } ],
  "headers": [
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ]
}
